# ── Desarrollo local ────────────────────────────────────────────────────────
SECRET_KEY=cambia-esta-llave-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Para dev rapido, SQLite. Para parecerse a produccion,
# arranca un Postgres local con docker y apunta DATABASE_URL aqui.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://erp_user:erp_pass@localhost:5432/erp_profesional

# CORS / Frontend
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis (opcional en dev — sin esto, el chat usa InMemoryChannelLayer y
# el cache usa LocMemCache, ambos validos en un solo proceso).
# REDIS_URL=redis://localhost:6379

# ── Storage S3 (opcional, recomendado en prod) ──────────────────────────────
# AWS_STORAGE_BUCKET_NAME=erp-media
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_REGION_NAME=us-east-1

# ── Produccion (Render los inyecta automaticamente desde render.yaml) ───────
# DEBUG=False
# ALLOWED_HOSTS=erp-backend.onrender.com
# DATABASE_URL=postgres://...
# REDIS_URL=redis://...
# CORS_ORIGIN=https://erp-profesional.vercel.app
# FRONTEND_URL=https://erp-profesional.vercel.app
# SECURE_SSL_REDIRECT=True
